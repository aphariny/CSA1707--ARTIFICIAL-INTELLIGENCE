
graph = {}

n = int(input("Enter number of nodes: "))

for i in range(n):
    node = input("Enter node: ")
    neighbors = input("Enter neighbors: ").split()
    graph[node] = {}

    for neighbor in neighbors:
        cost = int(input("Cost to " + neighbor + ": "))
        graph[node][neighbor] = cost

h = {}
for node in graph:
    h[node] = int(input("Heuristic of " + node + ": "))

start = input("Enter start node: ")
goal = input("Enter goal node: ")

open_list = [(h[start], 0, start, [start])]
visited = set()

while open_list:
    open_list.sort()
    f, g, node, path = open_list.pop(0)

    if node == goal:
        print("Shortest path:", " -> ".join(path))
        print("Total cost:", g)
        break

    if node in visited:
        continue

    visited.add(node)

    for neighbor, cost in graph[node].items():
        if neighbor not in visited:
            new_g = g + cost
            new_f = new_g + h[neighbor]
            open_list.append((new_f, new_g, neighbor, path + [neighbor]))
else:
    print("No path found")
